{
  "name": "half-life",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DISABLE_SWC_DOWNLOAD=1 next dev",
    "build": "rm -rf .next && NEXT_DISABLE_SWC_DOWNLOAD=1 next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
