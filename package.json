  },
  "prisma": {
    "seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
