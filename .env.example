# Prisma SQLite Database URL
DATABASE_URL="file:./dev.db"

# Bifrost Gateway Configuration (Maxim AI)
# Start local gateway: npx -y @maximhq/bifrost
BIFROST_BASE_URL="http://localhost:8080/openai"
OPENAI_API_KEY=""
